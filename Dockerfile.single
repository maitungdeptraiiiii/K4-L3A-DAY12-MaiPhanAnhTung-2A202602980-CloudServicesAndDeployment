# Bản 1 stage, chỉ dùng để đo kích thước cho exercises.md (Câu 3).
# Giống Dockerfile chính nhưng: một stage, base python:3.11 đầy đủ, chạy root.
FROM python:3.11

WORKDIR /app

COPY . .

RUN pip install -r requirements.txt

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
